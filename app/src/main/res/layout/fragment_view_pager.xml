<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.9"
    android:background="@drawable/viewpager_background"
    tools:context=".ViewPagerFragment">

    <LinearLayout
        android:id="@+id/layoutViewPagerLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ViewPagerTitleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_margin="16dp"
            android:text="Добро пожаловать в приложение Погода"
            android:textColor="@color/textColor"
            android:textSize="36sp"
            android:textStyle="italic" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/viewPagerIV"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:backgroundTint="#00000000"
                android:scaleType="centerCrop"
                android:background="@color/cardview_dark_background"
                app:shapeAppearanceOverlay="@style/roundedImageView"
                android:src="@drawable/weather_app"/>


        <Button
            android:id="@+id/startBTN"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="180dp"
            android:padding="18dp"
            android:text="Начать"
            android:visibility="gone"
            android:backgroundTint="#B2D7FB"
            android:textColor="#332A24"
            android:textSize="24sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>